    public static int solve(int n,int m,int[][] arr){
      int p1 = -1; int p2 = -1;
      DSU dsu = new DSU(n);
      for(int[] edge : arr ){
        int u = edge[0];
        int v = edge[1];
        dsu.union(u-1,v-1);
        if(p1 == -1 && p2 == -1){
          p1 = u;
          p2 = v;
        }
        else{
          if( p1 != u && p1 != v){
            p1 = -10;
          }
          if( p2 != u && p2 != v){
            p2 = -10;
          }
        }
        // System.out.println(Arrays.toString(dsu.parent));
      }
      int[] p = dsu.parent;
      int[] s = dsu.size;

      // System.out.println(Arrays.toString(p));

      HashSet<Integer> set1 = new HashSet<>();
      HashSet<Integer> set2 = new HashSet<>();
      int groups = 0;
      for(int i = 0;i<n;i++){
        p[i] = dsu.findParent(i);
        // System.out.println(Arrays.toString(p));

        if(p[i] == i) groups++;
        // System.out.println(p[i]);

        if(set2.contains(p[i])){
          // System.out.println("-------------------------");
          continue;
        }
        if(set1.contains(p[i])){
          set1.remove(p[i]);
          set2.add(p[i]);
        }
