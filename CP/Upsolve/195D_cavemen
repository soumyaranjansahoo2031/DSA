      if(groups > 1) return 3;
      if(p1 != -10 || p2 != -10) return 2;
      // if( n == 3 && m == 2) return 2;
      // if( n == 2 ) return 2;
      return 3;
    }
    
}

class DSU{
  int[] parent;
  int[] size;

  DSU(int n){
    parent = new int[n];
    size = new int[n];
    for(int i = 0;i<n;i++){
      parent[i] = i;
    }
    Arrays.fill(size,1);
  }
  int findParent(int x){
    if(parent[x] == x) return x;
    return parent[x] = findParent(parent[x]);
  }
  void union(int x,int y){
    int px = findParent(x);
    int py = findParent(y);
    if(px == py) return;
    if(size[px] > size[py]){
      parent[py] = px;
      size[px] += size[py];
    }
    else{
      parent[px] = py;
      size[py] += size[px];
    }
  }
}
